{
  "id": "./",
  "name": "DocShift – File Converter",
  "short_name": "DocShift",
  "description": "Turn Mac files into Windows files and back: documents, spreadsheets, presentations, photos, video and audio, privately on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#0067c0",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/*",
            "text/*",
            "image/*",
            "video/*",
            "audio/*",
            ".pages",
            ".numbers",
            ".key",
            ".heic",
            ".webarchive",
            ".md",
            ".csv"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.apple.pages": [
          ".pages"
        ],
        "application/vnd.apple.numbers": [
          ".numbers"
        ],
        "application/vnd.apple.keynote": [
          ".key"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/vnd.oasis.opendocument.text": [
          ".odt"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods"
        ],
        "application/vnd.oasis.opendocument.presentation": [
          ".odp"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/rtf": [
          ".rtf"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/csv": [
          ".csv"
        ],
        "text/tab-separated-values": [
          ".tsv"
        ],
        "text/plain": [
          ".txt"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ],
        "image/tiff": [
          ".tif",
          ".tiff"
        ],
        "image/icns": [
          ".icns"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/x-matroska": [
          ".mkv"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/x-msvideo": [
          ".avi"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/aiff": [
          ".aiff",
          ".aif"
        ],
        "audio/x-caf": [
          ".caf"
        ],
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/flac": [
          ".flac"
        ],
        "application/x-webarchive": [
          ".webarchive"
        ]
      }
    }
  ]
}

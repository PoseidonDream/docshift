    "html-to-pdfmake": "2.5.30",
    "jszip": "3.10.1",
    "libheif-js": "1.23.5",
    "pandoc-wasm": "1.1.0",
    "pdfjs-dist": "4.10.38",
    "pdfmake": "0.2.20",

{
  "name": "docshift",
  "version": "1.1.0",
  "private": true,
  "description": "Private, in-browser document converter: Pages, Numbers, Keynote, Word, Excel, PowerPoint, PDF, OpenDocument, Markdown, images.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "python3 -m http.server 8080 -d dist"
  },
  "dependencies": {
    "html-to-pdfmake": "2.5.30",
    "jszip": "3.10.1",
    "pandoc-wasm": "1.1.0",
    "pdfjs-dist": "4.10.38",
    "pdfmake": "0.2.20",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
